# MinIO（业务对象存储）
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=kbadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_RAW=kb-raw
MINIO_SECURE=false

# MySQL（元数据）
MYSQL_HOST=localhost
# 宿主机映射端口（本机已有 MySQL 占用 3306）。容器内由 compose 固定为 3306。
MYSQL_PORT=3307
MYSQL_DATABASE=kb
MYSQL_USER=kb
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root

# Milvus（向量）
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kb_blocks

# LLM（OpenAI 兼容：DeepSeek / 豆包 / GPT 改 base_url 即可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embedding
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
